---
import type { Release } from '../loaders/releases';
import { renderNotes } from '../lib/markdown';
import { localeFromAstro, t } from '../lib/text';
import type { SiteLocale } from '../lib/text';

interface Props {
  releases?: Release[];
  locale?: SiteLocale;
}

const props = Astro.props;
let releases = props.releases;
if (!releases) {
  const { getCollection } = await import('astro:content');
  releases = (await getCollection('releases')).map((e) => e.data as Release);
}
const locale = props.locale ?? localeFromAstro(Astro.currentLocale);
const sorted = [...releases].sort((a, b) => Date.parse(b.date) - Date.parse(a.date));
const notesHtml = (r: Release) => (r.body.trim() ? renderNotes(r.body) : '');
---

{
  sorted.length === 0 ? (
    <p>{t(locale, 'notes.no-releases')}</p>
  ) : (
    sorted.map((r) => (
      <section class="fk-release">
        <h2 id={r.tag}>{r.name}</h2>
        <p>
          {r.date.slice(0, 10)}
          {r.prerelease && <> · {t(locale, 'notes.prerelease')}</>} · <a href={r.url}>{t(locale, 'notes.github')}</a>
        </p>
        {notesHtml(r) ? <div set:html={notesHtml(r)} /> : <p>{t(locale, 'notes.none')}</p>}
      </section>
    ))
  )
}
