<UserControl x:Class="FormatKit.App.Views.RunProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FormatKit.App.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Nav_RunProfile}" FontSize="28" FontWeight="SemiBold" />

            <!-- Choose -->
            <StackPanel Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{loc:Loc RunProfile_Intro}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <Border Margin="0,12,0,0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="Orange"
                        Visibility="{Binding HasRunMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding RunMessage}" TextWrapping="Wrap" />
                </Border>
                <Button Content="{loc:Loc RunProfile_Open}" Command="{Binding OpenCommand}"
                        HorizontalAlignment="Left" Padding="24,6" Margin="0,16,0,0" />
                <StackPanel Margin="0,16,0,0" Visibility="{Binding HasLastProfile, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Loc RunProfile_LastProfile}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LastProfile}" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" />
                    <Button Content="{loc:Loc RunProfile_UseLast}" Command="{Binding UseLastProfileCommand}"
                            HorizontalAlignment="Left" Padding="16,4" Margin="0,8,0,0" />
                </StackPanel>
                <Button Content="{loc:Loc RunProfile_DriversOnly}" Command="{Binding UseDriversOnlyCommand}"
                        HorizontalAlignment="Left" Padding="16,4" Margin="0,24,0,0" />
                <TextBlock Text="{loc:Loc RunProfile_DriversOnlyHint}" Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Review -->
            <StackPanel Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ProfileName}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding ProfilePath}" Opacity="0.75" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{loc:Loc RunProfile_Reload}" Command="{Binding ReloadCommand}" Padding="16,4" />
                    <Button Content="{loc:Loc RunProfile_ChooseAnother}" Command="{Binding ChooseAnotherCommand}"
                            Padding="16,4" Margin="8,0,0,0" />
                </StackPanel>

                <Border Margin="0,12,0,0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="Firebrick"
                        Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc RunProfile_Errors}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Errors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Path}" Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Loc RunProfile_Plan}" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock Text="{loc:Loc RunProfile_NeedsAdmin}" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0"
                               Visibility="{Binding PlanNeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Plan}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,8,0,0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="Gray">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="3" BorderThickness="1"
                                                    BorderBrush="Orange" VerticalAlignment="Center"
                                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{loc:Loc RunProfile_Admin}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Id}" Opacity="0.6" FontSize="11" />
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Text="{loc:Loc RunProfile_NoSteps}" TextWrapping="Wrap" Margin="0,16,0,0"
                           Visibility="{Binding HasNoSteps, Converter={StaticResource BoolToVisibility}}" />

                <Border Margin="0,12,0,0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="Orange"
                        Visibility="{Binding HasRunMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding RunMessage}" TextWrapping="Wrap" />
                </Border>

                <Button Content="{loc:Loc RunProfile_Run}" Command="{Binding RunCommand}"
                        HorizontalAlignment="Left" Padding="24,6" Margin="0,16,0,0"
                        Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Running and result -->
            <StackPanel Visibility="{Binding IsShowingRun, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ProfileName}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Loc RunProfile_Stop}" Command="{Binding StopCommand}" Padding="16,4" />
                        <TextBlock Text="{loc:Loc RunProfile_StopHint}" Opacity="0.75" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding IsResult, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding FinalStatus}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,0" />
                    <TextBlock Text="{loc:Loc RunProfile_CanResume}" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0"
                               Visibility="{Binding HasInterruptedRun, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Loc RunProfile_Resume}" Command="{Binding ResumeCommand}" Padding="16,4" Margin="0,0,8,0"
                                Visibility="{Binding HasInterruptedRun, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{loc:Loc RunProfile_OpenReport}" Command="{Binding OpenReportCommand}" Padding="16,4" />
                        <Button Content="{loc:Loc RunProfile_OpenLogs}" Command="{Binding OpenLogFolderCommand}" Padding="16,4"
                                Margin="8,0,0,0" Visibility="{Binding EndedWithoutResult, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{loc:Loc RunProfile_ChooseAnother}" Command="{Binding ChooseAnotherCommand}"
                                Padding="16,4" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Margin="0,8,0,0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="Gray">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   Foreground="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding StateText}" Foreground="{Binding Color}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConsoleHint}" TextWrapping="Wrap" FontWeight="SemiBold"
                                               Foreground="#5B8DB8" Margin="0,4,0,0"
                                               Visibility="{Binding IsWaitingForConsole, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Messages}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding NextActionText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="#5B8DB8" />
                                    <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
