<UserControl x:Class="FormatKit.App.Views.ChecklistPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FormatKit.App.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Nav_Checklist}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Checklist_Intro}" Margin="0,8,0,0" TextWrapping="Wrap" />

            <TextBlock Text="{loc:Loc Checklist_Profile}" Margin="0,16,0,0" FontWeight="SemiBold" />
            <TextBox Text="{Binding ProfilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="4" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{loc:Loc Checklist_Browse}" Command="{Binding BrowseProfileCommand}" Padding="16,4" />
                <Button Content="{loc:Loc Checklist_Clear}" Command="{Binding ClearProfileCommand}" Padding="16,4" Margin="8,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="{loc:Loc Checklist_Check}" Command="{Binding CheckCommand}" Padding="24,6" />
                <Button Content="{loc:Loc Checklist_Save}" Command="{Binding SaveMarkdownCommand}" Padding="16,6" Margin="8,0,0,0" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Border Margin="0,12,0,0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="Firebrick"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </Border>

            <Border Margin="0,12,0,0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="Firebrick"
                    Visibility="{Binding HasProfileErrors, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Checklist_ProfileErrors}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ProfileErrors}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Path}" Opacity="0.75" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Summary}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}" />
            <Border Margin="0,12,0,0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="Orange"
                    Visibility="{Binding SaveSucceeded, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SaveMessage}" TextWrapping="Wrap" />
            </Border>

            <Border Margin="0,12,0,0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="Firebrick"
                    Visibility="{Binding SaveFailed, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SaveMessage}" TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="{Binding StartsExpanded, Mode=OneWay}"
                                  Margin="0,16,0,0" FontSize="18" FontWeight="SemiBold">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Sections}" FontSize="12" FontWeight="Normal">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,6,0,0" Padding="12" CornerRadius="4"
                                                                BorderThickness="1,1,1,1" BorderBrush="{Binding Color}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Detail}" Opacity="0.75" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Action}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
