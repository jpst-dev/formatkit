<UserControl x:Class="FormatKit.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FormatKit.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Nav_About}" FontSize="28" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="{loc:Loc About_Version}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Version}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0">
                <Hyperlink NavigateUri="{Binding RepositoryUrl}" RequestNavigate="OnRequestNavigate">
                    <TextBlock Text="{Binding RepositoryUrl}" />
                </Hyperlink>
            </TextBlock>
            <Button Content="{loc:Loc About_OpenLogs}" Command="{Binding OpenLogFolderCommand}"
                    HorizontalAlignment="Left" Margin="0,16,0,0" Padding="16,4" />

            <TextBlock Text="{loc:Loc About_CliTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8" />
            <ItemsControl ItemsSource="{Binding CliCommands}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Command}" FontFamily="Consolas" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
