<UserControl x:Class="FormatKit.App.Views.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FormatKit.App.Localization">
    <StackPanel Margin="32" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Loc Placeholder_Soon}" Margin="0,12,0,0" Opacity="0.75" />
    </StackPanel>
</UserControl>
