<UserControl x:Class="FormatKit.App.Views.CleanupDiagnosisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FormatKit.App.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Nav_CleanupDiagnosis}" FontSize="28" FontWeight="SemiBold" />

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Border Margin="0,12,0,0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="Firebrick"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </Border>

            <Button Content="{loc:Loc Diag_Refresh}" Command="{Binding LoadCommand}" Padding="16,4"
                    Margin="0,12,0,0" HorizontalAlignment="Left" />

            <TextBlock Text="{loc:Loc Check_NoFindings}" Margin="0,16,0,0"
                       Visibility="{Binding NoFindings, Converter={StaticResource BoolToVisibility}}" />

            <Border Margin="0,12,0,0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="Orange"
                    Visibility="{Binding HasNotChecked, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding NotCheckedText}" TextWrapping="Wrap" />
            </Border>
            <Border Margin="0,12,0,0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="Orange"
                    Visibility="{Binding HasJournalError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding JournalErrorText}" TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Findings}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,8,0,0" Padding="12" CornerRadius="4"
                                                BorderThickness="1" BorderBrush="Gray">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Opacity="0.75" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Breaks}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Fix}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
