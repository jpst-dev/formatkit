<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>formatkit</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained Condition="'$(_IsPublishing)' == 'true'">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>..\..\assets\formatkit.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FormatKit.Core\FormatKit.Core.csproj" />
    <ProjectReference Include="..\FormatKit.Cleanup\FormatKit.Cleanup.csproj" />
    <ProjectReference Include="..\FormatKit.Drivers\FormatKit.Drivers.csproj" />
    <ProjectReference Include="..\FormatKit.Programs\FormatKit.Programs.csproj" />
    <ProjectReference Include="..\FormatKit.Dev\FormatKit.Dev.csproj" />
    <ProjectReference Include="..\FormatKit.Prepare\FormatKit.Prepare.csproj" />
    <ProjectReference Include="..\FormatKit.Hosting\FormatKit.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FormatKit.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>
</Project>
